-- BLOCK: CONDITIONAL ACCESS POLICIES
-- ================================

-- ⏳ Combines time-based and region-based access control
-- 🗓️ Access allowed until 2025-12-31, only for designated viewers by country
-- 🚧 TODO: Parameterize expiry date for flexibility in future use
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.rlf_country_filter_expiring_2025(
  ca_country STRING
)
RETURNS BOOLEAN
RETURN CASE
  WHEN CURRENT_DATE <= DATE('2025-12-31') THEN
    CASE
      WHEN ca_country = 'Australia' THEN is_account_group_member('AU_Viewers')
      WHEN ca_country = 'New Zealand' THEN is_account_group_member('NZ_Viewers')
      ELSE FALSE
    END
  ELSE FALSE  -- 🚫 Access revoked after expiry
END;
