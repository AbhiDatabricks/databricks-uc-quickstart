-- ================================
-- BLOCK: ROW FILTER FUNCTIONS
-- ================================

-- ❌ Completely filters out all rows for users
-- 📌 Use this for highly restricted tables that should not be accessed by any role
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.no_rows()
RETURNS BOOLEAN
RETURN FALSE;

-- ✅ Allows access to rows only during business hours (9 AM – 6 PM AEST)
-- 📌 Useful for compliance with time-based access policies (e.g. offshore team restrictions)
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.business_hours_filter()
RETURNS BOOLEAN
RETURN hour(from_utc_timestamp(current_timestamp(), 'Australia/Melbourne')) BETWEEN 9 AND 18;

-- ================================
-- BLOCK: COLUMN MASKING FUNCTIONS
-- ================================

-- 🔒 Masks sensitive column for all roles (no one can see the value)
-- 📌 Returns NULL regardless of input — useful for columns like SSN, tax ID, etc.
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.mask_for_all_roles(id DECIMAL)
RETURNS DECIMAL
RETURN NULL;

-- 🧠 Deterministic masking for referential joins
-- 🔄 Preserves the ability to join on masked columns without revealing raw values
-- 📌 Uses a deterministic multiplier based on CRC32 hash of the ID
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.mask_decimal_p_referential(id DECIMAL)
RETURNS DECIMAL
RETURN 
id * t3_a00cd1_snd_arg02_dbws01.ext_parquet.fast_deterministic_multiplier(id);

-- ⚙️ High-performance deterministic multiplier function
-- 📌 Applies a lightweight transformation using CRC32 over the ID (cast as binary)
-- ✅ Fast and join-safe — ensures deterministic output per input ID
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.fast_deterministic_multiplier(id DECIMAL)
RETURNS DECIMAL
RETURN 1 + MOD(CRC32(CAST(CAST(id AS STRING) AS BINARY)), 1000) * 0.001;

-- 🔐 Simple irreversible masking for string inputs
-- 📌 Uses SHA-256 for secure, one-way masking of values (e.g., email, phone)
CREATE OR REPLACE FUNCTION t3_a00cd1_snd_arg02_dbws01.ext_parquet.mask_nz_string(input STRING)
RETURNS STRING
RETURN sha2(input, 256);

